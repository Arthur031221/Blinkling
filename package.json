{
  "name": "blinkling",
  "version": "3.2.7",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:features": "vitest run scripts/features.test.mjs && node --import ./desktop/shared/test-env.mjs --test scripts/remote-guard.test.mjs",
    "lint": "eslint .",
    "check:name": "node scripts/check-name.mjs && node --test scripts/check-name.test.mjs",
    "check:brand": "node scripts/check-brand.mjs && node --test scripts/check-brand.kit.test.mjs",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check": "npm run check:name && npm run check:brand && npm run lint && npm run format:check && npm test && npm run test:features && npm run build:plugin && npm run test:plugin && npm run validate:plugin && npm run test:extension",
    "build:plugin": "npm run build:extension && node scripts/build-plugin.mjs",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "validate:plugin:claude": "claude plugin validate . --strict",
    "test:plugin": "node --import ./desktop/shared/test-env.mjs --test bridge/test/*.test.mjs",
    "test:e2e": "npm run build:plugin && node scripts/mcp-e2e.mjs",
    "build:extension": "tsc -p tsconfig.extension.json && node scripts/build-extension.mjs",
    "package:extension": "npm run build:extension && python3 scripts/package-extension.py",
    "package:stores": "npm run package:extension && python3 scripts/package-stores.py",
    "test:extension": "npm run build:plugin && bash scripts/extension-e2e.sh",
    "desktop:start": "npm start --workspace @blinkling/desktop",
    "desktop:build": "npm run build --workspace @blinkling/desktop",
    "desktop:package": "npm run desktop:build && node desktop/distribution/package.mjs",
    "desktop:test": "npm test --workspace @blinkling/desktop && node --import ./desktop/shared/test-env.mjs --test plugin/desktop/*.test.mjs",
    "desktop:e2e": "npm run test:e2e --workspace @blinkling/desktop",
    "desktop:check": "npm run desktop:test && tsc -p desktop/tsconfig.json"
  },
  "workspaces": [
    "bridge",
    "desktop"
  ],
  "dependencies": {
    "pdfjs-dist": "5.4.624"
  },
  "devDependencies": {
    "@electron/packager": "19.0.1",
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.64.0",
    "@types/chrome": "0.3.5",
    "acorn": "8.19.0",
    "electron": "44.7.2",
    "esbuild": "0.25.10",
    "eslint": "9.35.0",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.1",
    "vitest": "5.0.3"
  }
}
