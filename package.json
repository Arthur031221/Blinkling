{
  "name": "glimpselet",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc -b && vite build",
    "test": "vitest run",
    "lint": "eslint .",
    "format:check": "prettier --check .",
    "format": "prettier --write .",
    "check": "npm run lint && npm run format:check && npm test && npm run build && npm run build:plugin && npm run test:plugin && npm run validate:plugin",
    "build:plugin": "node scripts/build-plugin.mjs",
    "validate:plugin": "node scripts/validate-plugin.mjs",
    "validate:plugin:claude": "claude plugin validate . --strict",
    "test:plugin": "node --test bridge/test/*.test.mjs",
    "demo": "node scripts/demo.mjs",
    "test:e2e": "npm run build && npm run build:plugin && node scripts/mcp-e2e.mjs && xvfb-run -a playwright test",
    "record-demo": "node scripts/record-demo.mjs",
    "test:screen": "xvfb-run -a node scripts/screen-e2e.mjs"
  },
  "workspaces": [
    "bridge"
  ],
  "dependencies": {
    "dompurify": "3.4.16",
    "marked": "16.3.0",
    "react": "19.1.1",
    "react-dom": "19.1.1"
  },
  "devDependencies": {
    "@eslint/js": "9.35.0",
    "@playwright/test": "1.64.0",
    "@types/dompurify": "3.0.5",
    "@types/react": "19.1.12",
    "@types/react-dom": "19.1.9",
    "@vitejs/plugin-react": "5.0.2",
    "esbuild": "0.25.10",
    "eslint": "9.35.0",
    "globals": "16.4.0",
    "jsdom": "26.1.0",
    "prettier": "3.6.2",
    "typescript": "5.9.2",
    "typescript-eslint": "8.71.1",
    "vite": "7.3.7",
    "vitest": "5.0.3"
  }
}
