#!/bin/sh
# macOS and Linux: finds Node.js 22 or newer, or fetches a private copy, then
# becomes: node <script> [args]. Under Git Bash on Windows it only finds an
# installed Node.js (bin/blinkling-run.cmd and the .exe next to it do the same
# for a process that has no shell). Modes:
#   mcp     the MCP server; waits for a download and fails with one message
#   start   SessionStart; starts the download in the background, never fails
#   notice  UserPromptSubmit; says once that Node is missing
#   hook    every other hook; silent
mode=$1
[ $# -gt 0 ] && shift

root=${BLINKLING_FS_ROOT:-}
home=${HOME:-/tmp}
state=${BLINKLING_RUNTIME_DIR:-$home/.blinkling/runtime}
self=$0

case $(uname -s 2>/dev/null) in
  MINGW* | MSYS* | CYGWIN*) windows=1 ;;
  *) windows= ;;
esac

node_version=24.22.0
mirror=${BLINKLING_NODE_MIRROR:-https://nodejs.org/dist}

usable() {
  [ -x "$1" ] && "$1" -e 'process.exit(+process.versions.node.split(".")[0]>=22?0:1)' >/dev/null 2>&1
}

remember() {
  mkdir -p "$state" 2>/dev/null || return 0
  printf '%s\n' "$1" >"$state/node-path.$$" 2>/dev/null && mv -f "$state/node-path.$$" "$state/node-path" 2>/dev/null
  rm -f "$state/no-node-noticed" 2>/dev/null
  return 0
}

# Sets $found. Looks only at files; never runs a version manager.
find_node() {
  found=
  if [ -r "$state/node-path" ]; then
    read -r cached <"$state/node-path" 2>/dev/null
    if [ -n "$cached" ] && [ -x "$cached" ]; then
      found=$cached
      return 0
    fi
  fi
  candidate=$(command -v node 2>/dev/null)
  if [ -n "$candidate" ] && usable "$candidate"; then
    found=$candidate
    remember "$found"
    return 0
  fi
  for candidate in \
    "$root/opt/homebrew/bin/node" "$root/usr/local/bin/node" "$root/usr/bin/node" \
    "$home/.local/bin/node" "$home/.volta/bin/node" "$home/.asdf/shims/node" \
    "$home/.local/share/mise/shims/node" "$state/node/bin/node"; do
    if usable "$candidate"; then
      found=$candidate
      remember "$found"
      return 0
    fi
  done
  # Version managers keep one folder per version: take the last that works.
  for candidate in \
    "$home/.nvm/versions/node/"*/bin/node \
    "$home/.local/share/fnm/node-versions/"*/installation/bin/node \
    "$home/Library/Application Support/fnm/node-versions/"*/installation/bin/node \
    "$home/.fnm/node-versions/"*/installation/bin/node \
    "$home/.asdf/installs/nodejs/"*/bin/node \
    "$home/.local/share/mise/installs/node/"*/bin/node \
    "$root/usr/local/n/versions/node/"*/bin/node \
    "$root/opt/homebrew/opt/"node*/bin/node; do
    if usable "$candidate"; then
      found=$candidate
    fi
  done
  if [ -n "$found" ]; then
    remember "$found"
    return 0
  fi
  return 1
}

# Downloads the pinned Node into $state/node. Prints nothing; returns 0 when
# a usable node exists afterwards.
fetch_node() {
  os=$(uname -s 2>/dev/null)
  arch=$(uname -m 2>/dev/null)
  case $os in
    Darwin)
      os=darwin
      # Rosetta reports x86_64 for a shell on an Apple Silicon Mac.
      if [ "$(sysctl -n hw.optional.arm64 2>/dev/null)" = 1 ]; then arch=arm64; else arch=x64; fi
      ;;
    Linux)
      os=linux
      case $arch in aarch64 | arm64) arch=arm64 ;; x86_64 | amd64) arch=x64 ;; *) return 1 ;; esac
      ;;
    *) return 1 ;;
  esac
  case $os-$arch in
    darwin-arm64) sha=6a9724d9b50a5f22b4816cded441b5a8d9ddae546191a5e5b7efa5a5e2ee26d5 ;;
    darwin-x64) sha=495e3f273c645f3c4677d438304cdfc701729ea5dec5728f5c8e76a2dece4b91 ;;
    linux-arm64) sha=b7e7991d5407815adfa74a2a9cd4db683552c8ce32ff4a295c22e972849c3f5d ;;
    linux-x64) sha=28ea0a438de9a13bd7891fd758eee6c7819ee8af5442dfd8d45bd65e56d4228c ;;
    *) return 1 ;;
  esac
  # A mirror (for tests and offline caches) brings its own digest.
  if [ -n "$BLINKLING_NODE_MIRROR" ] && [ -n "$BLINKLING_NODE_SHA256" ]; then
    sha=$BLINKLING_NODE_SHA256
  fi
  command -v curl >/dev/null 2>&1 || return 1
  command -v tar >/dev/null 2>&1 || return 1
  mkdir -p "$state" 2>/dev/null || return 1

  lock=$state/node.lock
  if ! mkdir "$lock" 2>/dev/null; then
    # Another start is fetching it. Wait for that one, unless it died.
    other=
    read -r other <"$lock/pid" 2>/dev/null
    if [ -n "$other" ] && kill -0 "$other" 2>/dev/null; then
      waited=0
      while [ "$waited" -lt "${BLINKLING_NODE_WAIT:-20}" ]; do
        [ -x "$state/node/bin/node" ] && usable "$state/node/bin/node" && return 0
        sleep 1
        waited=$((waited + 1))
        kill -0 "$other" 2>/dev/null || break
      done
      usable "$state/node/bin/node"
      return $?
    fi
    rm -rf "$lock"
    mkdir "$lock" 2>/dev/null || return 1
  fi
  printf '%s\n' "$$" >"$lock/pid"

  name=node-v$node_version-$os-$arch
  part=$state/$name.tar.gz.part
  curl -fsSL --retry 2 --connect-timeout 15 -C - -o "$part" "$mirror/v$node_version/$name.tar.gz" >/dev/null 2>&1
  got=
  if command -v sha256sum >/dev/null 2>&1; then
    got=$(sha256sum "$part" 2>/dev/null)
  elif command -v shasum >/dev/null 2>&1; then
    got=$(shasum -a 256 "$part" 2>/dev/null)
  elif command -v openssl >/dev/null 2>&1; then
    got=$(openssl dgst -sha256 "$part" 2>/dev/null | sed 's/.*= //')
  fi
  got=${got%% *}
  if [ -z "$got" ] || [ "$got" != "$sha" ]; then
    rm -f "$part"
    rm -rf "$lock"
    return 1
  fi
  stage=$state/node.new.$$
  rm -rf "$stage"
  mkdir -p "$stage" && tar -xzf "$part" -C "$stage" --strip-components=1 >/dev/null 2>&1
  rm -f "$part"
  if usable "$stage/bin/node"; then
    rm -rf "$state/node"
    mv "$stage" "$state/node"
    rm -rf "$lock"
    return 0
  fi
  rm -rf "$stage" "$lock"
  return 1
}

background_fetch() {
  [ -n "$windows" ] && return 0
  [ -d "$state/node.lock" ] && return 0
  (nohup "$self" fetch </dev/null >/dev/null 2>&1 &) >/dev/null 2>&1
  return 0
}

if [ "$mode" = fetch ]; then
  fetch_node
  exit 0
fi

if find_node; then
  exec "$found" "$@"
fi

case $mode in
  mcp)
    if [ -z "$windows" ] && fetch_node && find_node; then
      exec "$found" "$@"
    fi
    if [ -n "$windows" ]; then
      printf '%s\n' 'Blinkling needs Node.js 22 or newer on Windows. Install it from https://nodejs.org, then restart Claude Code.' >&2
    else
      printf '%s\n' 'Blinkling needs Node.js 22 or newer and could not fetch one. Install it from https://nodejs.org, then restart Claude Code.' >&2
    fi
    exit 1
    ;;
  start)
    background_fetch
    ;;
  notice)
    background_fetch
    if [ ! -e "$state/no-node-noticed" ]; then
      mkdir -p "$state" 2>/dev/null && : >"$state/no-node-noticed" 2>/dev/null
      if [ -n "$windows" ]; then
        printf '%s' '{"systemMessage":"Blinkling needs Node.js 22 or newer on Windows. Install it from nodejs.org, then restart Claude Code."}'
      else
        printf '%s' '{"systemMessage":"Blinkling is fetching a private copy of Node.js (about 45 MB) because this computer has none. When it is done, run /mcp and reconnect blinkling, then /blinkling:blinkling. Or install Node.js 22 or newer from nodejs.org."}'
      fi
    fi
    ;;
esac
exit 0
